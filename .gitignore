# Application runtime data, local logs, and cache
*.log
clipper.log
jobs.json*
user_prefs.json
logs/*
!logs/.gitkeep

# Video downloads, rendered clips, and export outputs
downloads/*
!downloads/.gitkeep
clips/*
!clips/.gitkeep
exports/*
!exports/.gitkeep

# Test artifacts
tests/audio_clips/
tests/test_clips/
tests/test_scratch/
tests/__pycache__/
config/user_overrides.yaml
